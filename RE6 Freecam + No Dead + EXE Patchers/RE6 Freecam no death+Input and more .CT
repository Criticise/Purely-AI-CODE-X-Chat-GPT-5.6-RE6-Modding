  local m223143 = m[2][2]*m[3][1]*m[4][3]
  local m223144 = m[2][2]*m[3][1]*m[4][4]
  local m223341 = m[2][2]*m[3][3]*m[4][1]
  local m223344 = m[2][2]*m[3][3]*m[4][4]
  local m223441 = m[2][2]*m[3][4]*m[4][1]
  local m223443 = m[2][2]*m[3][4]*m[4][3]
  local m233142 = m[2][3]*m[3][1]*m[4][2]
  local m233144 = m[2][3]*m[3][1]*m[4][4]
  local m233241 = m[2][3]*m[3][2]*m[4][1]
  local m233244 = m[2][3]*m[3][2]*m[4][4]
  local m233441 = m[2][3]*m[3][4]*m[4][1]
  local m233442 = m[2][3]*m[3][4]*m[4][2]
  local m243142 = m[2][4]*m[3][1]*m[4][2]
  local m243143 = m[2][4]*m[3][1]*m[4][3]
  local m243241 = m[2][4]*m[3][2]*m[4][1]
  local m243243 = m[2][4]*m[3][2]*m[4][3]
  local m243341 = m[2][4]*m[3][3]*m[4][1]
  local m243342 = m[2][4]*m[3][3]*m[4][2]


  local det = m[1][1] * (m223344 + m233442 + m243243 - m243342 - m233244 - m223443)
            - m[2][1] * (m123344 + m133442 + m143243 - m143342 - m133244 - m123443)
            + m[3][1] * (m122344 + m132442 + m142243 - m142342 - m132244 - m122443)
            - m[4][1] * (m122334 + m132432 + m142233 - m142332 - m132234 - m122433)

  return {{(m223344+m233442+m243243-m243342-m233244-m223443)/det,
           (-m123344-m133442-m143243+m143342+m133244+m123443)/det,
           (m122344+m132442+m142243-m142342-m132244-m122443)/det,
           (-m122334-m132432-m142233+m142332+m132234+m122433)/det},
          {(-m213344-m233441-m243143+m243341+m233144+m213443)/det,
           (m113344+m133441+m143143-m143341-m133144-m113443)/det,
           (-m112344-m132441-m142143+m142341+m132144+m112443)/det,
           (m112334+m132431+m142133-m142331-m132134-m112433)/det},
          {(m213244+m223441+m243142-m243241-m223144-m213442)/det,
           (-m113244-m123441-m143142+m143241+m123144+m113442)/det,
           (m112244+m122441+m142142-m142241-m122144-m112442)/det,
