 assert(BH6.exe+1190F50,00 BF 99 00 A0 CC 99 00)
 globalalloc(bh6_keep_blood_code_v3,$1000)
 label(bh6_keep_blood_return)
 label(bh6_keep_blood_skip)
 registersymbol(bh6_keep_blood_site)

bh6_keep_blood_code_v3:
  cmp ecx,1
  jne bh6_keep_blood_skip
  // uIdGameover00 instance, not the death-animation object uSmGameOver.
  cmp dword ptr [esi],BH6.exe+1190F40
  je bh6_keep_blood_skip
  mov edx,[esi]
  and eax,-06
  jmp bh6_keep_blood_return

bh6_keep_blood_skip:
  jmp bh6_keep_blood_site+59

bh6_keep_blood_return:
  jmp bh6_keep_blood_site+7

// uSmGameOver resource table: retain model, soft-hit and effect; omit 2 sounds
 aobscanmodule(ngo_usm_gameover_resource_table,BH6.exe,B8 07 62 01 98 49 86 01 98 07 62 01 6C 6D 7C 01 80 07 62 01 CC 6C 7C 01 68 07 62 01 D4 4F 86 01 68 07 62 01 CC 74 7C 01 05 00 00 00)
 assert(ngo_usm_gameover_resource_table+28,05 00 00 00)
 registersymbol(ngo_usm_gameover_resource_table)
 fullAccess(ngo_usm_gameover_resource_table+28,4)
ngo_usm_gameover_resource_table+28:
  db 03 00 00 00

// Publish the hook after its destination code has been written.
bh6_keep_blood_site:
  jmp bh6_keep_blood_code_v3
  db 90 90

[DISABLE]
 assert(ngo_usm_gameover_resource_table+28,03 00 00 00)
 ngo_usm_gameover_resource_table+28:
