  local m142241 = m[1][4]*m[2][2]*m[4][1]
  local m142243 = m[1][4]*m[2][2]*m[4][3]
  local m142331 = m[1][4]*m[2][3]*m[3][1]
  local m142332 = m[1][4]*m[2][3]*m[3][2]
  local m142341 = m[1][4]*m[2][3]*m[4][1]
  local m142342 = m[1][4]*m[2][3]*m[4][2]
  local m143142 = m[1][4]*m[3][1]*m[4][2]
  local m143143 = m[1][4]*m[3][1]*m[4][3]
  local m143241 = m[1][4]*m[3][2]*m[4][1]
