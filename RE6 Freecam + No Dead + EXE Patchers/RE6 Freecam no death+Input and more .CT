[ENABLE]
aobscanmodule(logic_fix,BH6.exe,75 ?? 8B 16 83 E0 FA 83 C8 02)
assert(logic_fix,75 57 8B 16 83 E0 FA 83 C8 02)
registersymbol(logic_fix)
logic_fix:
  db EB 57
[DISABLE]
{$lua}
if syntaxcheck then return end
-- KEEP BLOOD may own this address; never overwrite its active hook.
local keep = getAddressSafe('bh6_keep_blood_site')
local logic = getAddressSafe('logic_fix')
if not keep and logic then
  writeBytes(logic, 0x75, 0x57)
end
if logic then
  unregisterSymbol('logic_fix')
end
