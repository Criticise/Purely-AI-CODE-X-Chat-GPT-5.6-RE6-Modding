                <CheatEntry>
                  <ID>21913</ID>
                  <Description>"Disable Game Controller Input - Gemini"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{
  Game   : BH6.exe (Resident Evil 6)
  Feature: Controller Input &amp; Camera Hook
  Fixes  : Symbol registration and Beep feedback
}

[ENABLE]
// 1. 查找特征码（增加长度以确保唯一性，防止勾选不上）
aobscanmodule(instr_xinputgetstate, BH6.exe, 8B 0D ?? ?? ?? ?? 80 79 21 00 0F 84)
alloc(newmem, $1000)

label(code)
label(return)
label(xigs_bytes)

// 2. 注册符号（拆分注册，确保在 Table 列表中显示）
registersymbol(instr_xinputgetstate)
registersymbol(xigs_bytes)

newmem:
// 存储原始指令，用于 Disable 时恢复
xigs_bytes:
  readmem(instr_xinputgetstate, 6)

code:
  // 清空手柄输入干扰，防止相机自动归位
  and dword ptr [esi+2AC], 0
  and dword ptr [esi+2B0], 0
  and dword ptr [esi+2B4], 0

  // 补回被 jmp 覆盖的原始指令
  // 注意：这里的汇编需要与原始指令匹配
  db 8B 0D // mov ecx, [...] 的机器码
  readmem(instr_xinputgetstate+2, 4) // 动态读取原本的地址偏移

  jmp return

// 3. 注入脚本
instr_xinputgetstate:
  jmp code
  nop
return:

// 4. 激活反馈：发出高音“滴”一声
{$lua}
  if syntaxcheck then return end
  playSound(9)
  print("Camera Hook Activated: Controller Mode Enabled.")
{$asm}

[DISABLE]
// 5. 还原内存
instr_xinputgetstate:
  readmem(xigs_bytes, 6)

// 6. 清理符号和内存
unregistersymbol(instr_xinputgetstate)
unregistersymbol(xigs_bytes)
dealloc(newmem)

// 7. 关闭反馈：发出低音“嘟”一声
{$lua}
  if syntaxcheck then return end
  playSound(10)
{$asm}

