</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>63003</ID>
          <Description>"Auto-Fix Textures [未完成 / Unfinished]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ UNFINISHED: experimental state toggle only.
  This does not implement UTrainer's complete Auto-Fix Textures worker.
  Character/outfit mapping, pointer repair, and worker timing are missing.
  The texture repair effect is unverified. }
[ENABLE]
{$lua}
if syntaxcheck then return end
if gpt6_texture_timer then gpt6_texture_timer.destroy() end
gpt6_texture_timer = createTimer(nil, false)
gpt6_texture_timer.Interval = 100
gpt6_texture_last = {}
gpt6_texture_timer.OnTimer = function(t)
  local ok, mgr = pcall(readPointer, getAddress('BH6.exe+13C6468'))
  if not ok or not mgr or mgr == 0 then return end
  local cfg = readPointer(getAddress('BH6.exe+13C5454'))
  if not cfg or cfg == 0 then return end
  for slot=0,7 do
    local obj = readPointer(mgr + 0x24 + slot*4)
    if obj and obj ~= 0 then
      local ch = readBytes(cfg + 0x47D7C + slot*0x70, 1, false) or 0
      local outfit = readBytes(cfg + 0x47D7D + slot*0x70, 1, false) or 0
      local key = ch * 256 + outfit
      if gpt6_texture_last[slot] ~= nil and gpt6_texture_last[slot] ~= key then
        -- Re-enter the normal player refresh path. The descriptor pointer is
        -- left intact; this avoids corrupting character/服装 map ownership.
        writeInteger(obj + 0x38, 0)
        writeInteger(obj + 0x38, 0x201)
      end
      gpt6_texture_last[slot] = key
    end
  end
end
gpt6_texture_timer.Enabled = true
{$asm}
[DISABLE]
